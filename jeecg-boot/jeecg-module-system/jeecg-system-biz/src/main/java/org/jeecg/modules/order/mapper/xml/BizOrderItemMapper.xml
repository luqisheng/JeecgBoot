<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.order.mapper.BizOrderItemMapper">
    <select id="selectByMainId" resultType="org.jeecg.modules.order.entity.BizOrderItem">
